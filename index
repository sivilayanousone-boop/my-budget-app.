        async function fetchAllCloudData() {
            if (!sb || !currentPinInput) return;

            try {
                const { data: pinRecord, error: pinErr } = await sb
                    .from('user_pins')
                    .select('pin_id')
                    .eq('pin_id', currentPinInput);

                if (pinErr) throw pinErr;

                if (!pinRecord || pinRecord.length === 0) {
                    const { error: insErr } = await sb
                        .from('user_pins')
                        .insert([{ pin_id: currentPinInput }]);
                    if (insErr) throw insErr;
                }

                const [txData, goalData, splitData, splitParts] = await Promise.all([
                    sb.from('transactions').select('*').eq('pin_id', currentPinInput).order('date', { ascending: false }),
                    sb.from('saving_goals').select('*').eq('pin_id', currentPinInput).order('created_at', { ascending: false }),
                    sb.from('split_bills').select('*').eq('pin_id', currentPinInput).order('created_at', { ascending: false }),
                    sb.from('split_participants').select('*, split_bills!inner(pin_id)').eq('split_bills.pin_id', currentPinInput)
                ]);

                if (txData.error) throw txData.error;
                if (goalData.error) throw goalData.error;
                if (splitData.error) throw splitData.error;

                transactions = txData.data || [];
                goals = goalData.data || [];
                
                const allSplits = splitData.data || [];
                const allParts = splitParts.data || [];
                
                splits = allSplits.map(bill => {
                    return {
                        ...bill,
                        participants: allParts.filter(p => p.bill_id === bill.id)
                    };
                });

                renderTransactions();
                updateFinancialSummaries();
                renderGoals();
                renderSplits();

            } catch (err) {
                console.error("Failed to sync records from Supabase:", err);
            }
        }

