        window.processReceiptScanner = async function(event) {
            const file = event.target.files[0];
            if(!file) return;

            document.getElementById('loadingOverlay').classList.remove('hidden');
            document.getElementById('loadingText').innerText = "Gemini AI ກຳລັງສະແກນບິນ...";

            const reader = new FileReader();
            reader.onloadend = async () => {
                const base64Data = reader.result.split(',')[1];
                const validExpenseCategories = CATEGORIES.expense;
                const validIncomeCategories = CATEGORIES.income;

                const ocrSystemInstruction = `
                    You are a professional Multimodal Receipt Scanning robot. Analyze the uploaded receipt image, extract the numerical total cost, classify it as "expense" or "income".
                    Select exactly one mapping category:
                    - Expense: ${JSON.stringify(validExpenseCategories)}
                    - Income: ${JSON.stringify(validIncomeCategories)}
                    Extract the date (format YYYY-MM-DD). If date is not visible on the bill, default to today's date: "${new Date().toISOString().split('T')[0]}".
                    Identify a short descriptive merchant or transaction note in Lao language.
                `;

                try {
                    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${GEMINI_API_KEY}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            contents: [{
                                role: "user",
                                parts: [
                                    { text: "Parse and extract transactions from this receipt." },
                                    {
                                        inlineData: {
                                            mimeType: file.type,
                                            data: base64Data
                                        }
                                    }
                                ]
                            }],
                            generationConfig: {
                                responseMimeType: "application/json",
                                responseSchema: {
                                    type: "OBJECT",
                                    properties: {
                                        type: { type: "STRING", enum: ["income", "expense"] },
                                        amount: { type: "NUMBER" },
                                        category: { type: "STRING" },
                                        note: { type: "STRING" },
                                        date: { type: "STRING" }
                                    },
                                    required: ["type", "amount", "category", "note", "date"]
                                }
                            },
                            systemInstruction: {
                                parts: [{ text: ocrSystemInstruction }]
                            }
                        })
                    });

                    if(!response.ok) throw new Error("Receipt processing failed");
                    const resJson = await response.json();
                    const rawText = resJson?.candidates?.[0]?.content?.parts?.[0]?.text;
                    if(!rawText) throw new Error("No text response content");

                    const result = JSON.parse(rawText);
                    aiParsedDraft = result;

                    // Update UI Preview
                    document.getElementById('previewType').innerText = result.type === 'income' ? 'ລາຍຮັບ' : 'ລາຍຈ່າຍ';
                    document.getElementById('previewAmount').innerText = formatLaoLAK(result.amount) + " LAK";
                    document.getElementById('previewCategory').innerText = result.category;
                    document.getElementById('previewNote').innerText = result.note;
                    document.getElementById('previewDate').innerText = result.date;

                    document.getElementById('aiAutofillPreview').classList.remove('hidden');
                } catch(err) {
                    console.error("OCR Scanner failed:", err);
                    alert("ບໍ່ສາມາດສະແກນບິນນີ້ໄດ້. ກະລຸນາກວດສອບວ່າຮູບພາບຈະແຈ້ງດີບໍ່.");
                } finally {
                    document.getElementById('loadingOverlay').classList.add('hidden');
                }
            };
            reader.readAsDataURL(file);
        };

