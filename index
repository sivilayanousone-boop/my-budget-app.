            document.getElementById('loadingOverlay').classList.remove('hidden');
            document.getElementById('loadingText').innerText = "Gemini AI ກຳລັງແປງຂໍ້ຄວາມ...";

            const validExpenseCategories = CATEGORIES.expense;
            const validIncomeCategories = CATEGORIES.income;

            const nlpSystemInstruction = `
                You are an expert financial ledger text parser. Parse the user's input sentence in Lao and extract transaction elements as structured JSON.
                Classify the type as: "income" or "expense".
                Map the category logically:
                - If type is "expense", select exactly one category from: ${JSON.stringify(validExpenseCategories)}
                - If type is "income", select exactly one category from: ${JSON.stringify(validIncomeCategories)}
                If date is not specified, default to today's date: "${new Date().toISOString().split('T')[0]}".
                Extract raw numerical LAK amount.
                Provide a short descriptive Lao note.
            `;

            try {
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${GEMINI_API_KEY}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: query }] }],
                        generationConfig: {
                            responseMimeType: "application/json",
                            responseSchema: {
                                type: "OBJECT",
                                properties: {
                                    type: { type: "STRING", enum: ["income", "expense"] },
                                    amount: { type: "NUMBER" },
                                    category: { type: "STRING" },
                                    note: { type: "STRING" },
                                    date: { type: "STRING" }
                                },
                                required: ["type", "amount", "category", "note", "date"]
                            }
