<!DOCTYPE html>
<html lang="lo" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ລະບົບຕິດຕາມງົບປະມານ PWA - Supabase & Gemini AI</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Noto Sans Lao', 'Inter', 'sans-serif'],
                    },
                    boxShadow: {
                        'neon-emerald': '0 0 20px rgba(16, 185, 129, 0.15)',
                        'neon-indigo': '0 0 20px rgba(99, 102, 241, 0.15)',
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts: Noto Sans Lao & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Lao:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Supabase JS Client CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <!-- Inline CSS for fine-tuning layout and scrollbars -->
    <style>
        body {
            font-family: 'Noto Sans Lao', 'Inter', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        /* Hide scrollbar for cleaner mobile look */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        /* Custom styled scrollbars for transaction lists */
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.1);
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.2);
            border-radius: 10px;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between overflow-x-hidden">

    <!-- Loading overlay -->
    <div id="loadingOverlay" class="fixed inset-0 bg-slate-950/90 backdrop-blur-md z-50 flex flex-col items-center justify-center gap-4 transition-all duration-300">
        <div class="relative w-20 h-20 flex items-center justify-center">
            <div class="absolute inset-0 border-4 border-emerald-500/10 rounded-full"></div>
            <div class="absolute inset-0 border-4 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-emerald-400 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
        </div>
        <p id="loadingText" class="text-emerald-400 font-semibold text-sm animate-pulse tracking-wide">ກຳລັງເຊື່ອມຕໍ່ຖານຂໍ້ມູນຄລາວ...</p>
    </div>

    <!-- Google Sheets Tutorial Modal -->
    <div id="tutorialModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 max-w-sm w-full space-y-4">
            <div class="w-12 h-12 bg-emerald-500/10 text-emerald-400 rounded-2xl flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
            </div>
            <h3 class="text-base font-bold text-white">ວິທີນຳເຂົ້າ Google Sheets</h3>
            <ol class="text-xs text-slate-300 space-y-2.5 list-decimal pl-4 leading-relaxed">
                <li>ກົດປຸ່ມສົ່ງອອກຂໍ້ມູນ CSV ໃນແອັບນີ້.</li>
                <li>ເປີດ <strong class="text-emerald-400">Google Sheets</strong> ແລ້ວສ້າງຊີດໃໝ່.</li>
                <li>ກົດ <strong class="text-white">File -> Import</strong> (ໄຟລ໌ -> ນຳເຂົ້າ).</li>
                <li>ເລືອກແຖບ <strong class="text-white">Upload</strong> ແລ້ວອັບໂຫຼດໄຟລ໌ CSV ທີ່ຫາກໍ່ດາວໂຫຼດ.</li>
                <li>ເລືອກ <strong class="text-white">Replace spreadsheet</strong> ແລ້ວກົດ <strong class="text-emerald-500 font-semibold">Import data</strong>. ພາສາລາວຈະສະແດງຜົນຢ່າງຖືກຕ້ອງ 100%!</li>
            </ol>
            <button onclick="toggleTutorialModal(false)" class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 font-semibold rounded-xl text-xs transition-all active:scale-95">ເຂົ້າໃຈແລ້ວ</button>
        </div>
    </div>

    <!-- MAIN APP WRAPPER -->
    <div class="w-full max-w-md mx-auto flex-1 flex flex-col relative bg-slate-900 border-x border-slate-800/80 shadow-2xl">
        
        <!-- SCREEN 1: PIN AUTHENTICATION SCREEN -->
        <div id="screenAuth" class="flex-1 flex flex-col justify-between p-6">
            <div class="flex-1 flex flex-col items-center justify-center my-auto">
                <div class="w-20 h-20 bg-gradient-to-tr from-emerald-500 to-teal-400 rounded-3xl flex items-center justify-center shadow-lg shadow-emerald-500/20 mb-6 transform hover:rotate-12 transition duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                
                <h1 class="text-2xl font-bold text-white text-center tracking-tight">ຕິດຕາມງົບປະມານຄລາວ</h1>
                <p class="text-xs text-slate-400 text-center mt-2 px-6 leading-relaxed">ໃສ່ລະຫັດ PIN 4 ຕົວເລກຂອງທ່ານ ເພື່ອຊິ້ງຂໍ້ມູນທຸກອຸປະກອນຢ່າງປອດໄພ ແລະ ບໍ່ມີມື້ຫາຍສາບສູນ</p>
                
                <div class="flex gap-4 my-8">
                    <div class="pin-dot w-4 h-4 rounded-full border-2 border-slate-700 transition-all duration-200"></div>
                    <div class="pin-dot w-4 h-4 rounded-full border-2 border-slate-700 transition-all duration-200"></div>
                    <div class="pin-dot w-4 h-4 rounded-full border-2 border-slate-700 transition-all duration-200"></div>
                    <div class="pin-dot w-4 h-4 rounded-full border-2 border-slate-700 transition-all duration-200"></div>
                </div>
            </div>

            <!-- PIN Pad Keypad -->
            <div class="grid grid-cols-3 gap-3 w-full max-w-xs mx-auto mb-6">
                <button onclick="inputPinDigit('1')" class="h-14 rounded-2xl bg-slate-800/80 hover:bg-slate-700/80 active:scale-95 text-xl font-bold text-slate-100 transition-all duration-100">1</button>
                <button onclick="inputPinDigit('2')" class="h-14 rounded-2xl bg-slate-800/80 hover:bg-slate-700/80 active:scale-95 text-xl font-bold text-slate-100 transition-all duration-100">2</button>
                <button onclick="inputPinDigit('3')" class="h-14 rounded-2xl bg-slate-800/80 hover:bg-slate-700/80 active:scale-95 text-xl font-bold text-slate-100 transition-all duration-100">3</button>
                <button onclick="inputPinDigit('4')" class="h-14 rounded-2xl bg-slate-800/80 hover:bg-slate-700/80 active:scale-95 text-xl font-bold text-slate-100 transition-all duration-100">4</button>
                <button onclick="inputPinDigit('5')" class="h-14 rounded-2xl bg-slate-800/80 hover:bg-slate-700/80 active:scale-95 text-xl font-bold text-slate-100 transition-all duration-100">5</button>
                <button onclick="inputPinDigit('6')" class="h-14 rounded-2xl bg-slate-800/80 hover:bg-slate-700/80 active:scale-95 text-xl font-bold text-slate-100 transition-all duration-100">6</button>
                <button onclick="inputPinDigit('7')" class="h-14 rounded-2xl bg-slate-800/80 hover:bg-slate-700/80 active:scale-95 text-xl font-bold text-slate-100 transition-all duration-100">7</button>
                <button onclick="inputPinDigit('8')" class="h-14 rounded-2xl bg-slate-800/80 hover:bg-slate-700/80 active:scale-95 text-xl font-bold text-slate-100 transition-all duration-100">8</button>
                <button onclick="inputPinDigit('9')" class="h-14 rounded-2xl bg-slate-800/80 hover:bg-slate-700/80 active:scale-95 text-xl font-bold text-slate-100 transition-all duration-100">9</button>
                <button onclick="deletePinDigit()" class="h-14 rounded-2xl bg-slate-900 border border-slate-800 hover:bg-slate-800 active:scale-95 text-sm font-semibold text-rose-400 transition-all duration-100 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M3 12l6.414 6.414a2 2 0 001.414.586H19a2 2 0 002-2V7a2 2 0 00-2-2h-8.172a2 2 0 00-1.414.586L3 12z" />
                    </svg>
                </button>
                <button onclick="inputPinDigit('0')" class="h-14 rounded-2xl bg-slate-800/80 hover:bg-slate-700/80 active:scale-95 text-xl font-bold text-slate-100 transition-all duration-100">0</button>
                <button id="pwaInstallBtn" class="h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-[11px] font-semibold text-emerald-400 flex items-center justify-center text-center leading-tight hover:bg-emerald-500/20 transition-all active:scale-95 hidden">
                    ຕິດຕັ້ງແອັບ
                </button>
            </div>
        </div>

        <!-- SCREEN 2: MAIN DASHBOARD -->
        <div id="screenDashboard" class="hidden flex-1 flex flex-col justify-between overflow-y-auto no-scrollbar pb-24">
            
            <!-- Global Navigation Header -->
            <header class="bg-slate-900/95 backdrop-blur-md sticky top-0 z-40 border-b border-slate-800 px-4 py-3.5 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></div>
                    <span class="text-xs font-semibold text-slate-300">ບັນຊີ PIN: <span id="displayPinCode" class="font-mono bg-slate-800 px-2 py-0.5 rounded text-emerald-400 font-bold ml-1"></span></span>
                </div>
                <div class="flex items-center gap-1.5">
                    <button onclick="toggleTutorialModal(true)" title="ວິທີນຳເຂົ້າ Google Sheets" class="p-2 text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700 rounded-xl border border-slate-700/50 transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </button>
                    <button onclick="exportDataToCSV()" title="ສົ່ງອອກຂໍ້ມູນໄປ Google Sheets (CSV)" class="p-2 text-slate-400 hover:text-emerald-400 bg-slate-800 hover:bg-slate-700 rounded-xl border border-slate-700/50 transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                    </button>
                    <button onclick="performSignOut()" title="ອອກຈາກລະບົບ" class="p-2 text-rose-400 hover:text-rose-300 bg-rose-500/10 hover:bg-rose-500/20 rounded-xl border border-rose-500/20 transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                        </svg>
                    </button>
                </div>
            </header>

            <!-- TAB CONTAINER 1: TRANSACTIONS & BUDGET TRACKER -->
            <div id="tabTransactions" class="p-4 space-y-5 tab-content">
                
                <!-- Financial Overview Card -->
                <div class="bg-gradient-to-br from-slate-800 via-slate-800 to-slate-900 border border-slate-700/60 rounded-3xl p-5 shadow-xl relative overflow-hidden">
                    <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-emerald-500/5 rounded-full blur-2xl"></div>
                    
                    <p class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">ຍອດເຫຼືອທັງໝົດໃນລະບົບ</p>
                    <h2 id="summaryBalance" class="text-3xl font-black text-white mt-1 tracking-tight font-mono">0 LAK</h2>
                    
                    <div class="grid grid-cols-2 gap-4 mt-5 pt-4 border-t border-slate-800/80">
                        <div>
                            <p class="text-[11px] text-slate-400 flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> ລາຍຮັບທັງໝົດ
                            </p>
                            <p id="summaryIncome" class="text-sm font-bold text-emerald-400 mt-1 font-mono">+0 LAK</p>
                        </div>
                        <div>
                            <p class="text-[11px] text-slate-400 flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> ລາຍຈ່າຍທັງໝົດ
                            </p>
                            <p id="summaryExpense" class="text-sm font-bold text-rose-400 mt-1 font-mono">-0 LAK</p>
                        </div>
                    </div>
                </div>

                <!-- Date Range filter widget -->
                <div class="grid grid-cols-3 bg-slate-950 p-1 rounded-2xl border border-slate-800/80 shadow-inner">
                    <button onclick="setDateFilter('week')" id="filterBtnWeek" class="py-2 text-xs font-semibold rounded-xl transition-all duration-200 bg-slate-800 text-white shadow-sm">ອາທິດນີ້</button>
                    <button onclick="setDateFilter('month')" id="filterBtnMonth" class="py-2 text-xs font-semibold rounded-xl transition-all duration-200 text-slate-400 hover:text-slate-200">ເດືອນນີ້</button>
                    <button onclick="setDateFilter('all')" id="filterBtnAll" class="py-2 text-xs font-semibold rounded-xl transition-all duration-200 text-slate-400 hover:text-slate-200">ທັງໝົດ</button>
                </div>

                <!-- GEMINI AI POWERED QUICK INPUT CARD -->
                <div class="bg-gradient-to-r from-indigo-950 to-slate-900 border border-indigo-500/20 rounded-3xl p-4 shadow-lg space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-indigo-400 flex items-center gap-1.5">
                            <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-indigo-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
                            ຜູ້ຊ່ວຍບັນທຶກອັດສະລິຍະ Gemini AI
                        </span>
                        <span class="text-[9px] bg-indigo-500/20 text-indigo-300 font-semibold px-2 py-0.5 rounded-full">ປະຢັດເວລາ 10x</span>
                    </div>
                    
                    <div class="grid grid-cols-1 gap-2">
                        <!-- Smart Text Parser input -->
                        <div class="relative flex items-center">
                            <input type="text" id="aiNlpInput" placeholder="ພິມເຊັ່ນ: ຈ່າຍຄ່າເຂົ້າຜັດ 25,000 ກີບ..." class="w-full bg-slate-950 border border-slate-800 text-xs rounded-xl pl-3 pr-10 py-3 text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition-all">
                            <button onclick="processNlpTransaction()" title="ແປງເປັນທຸລະກຳດ້ວຍ AI" class="absolute right-2 p-1.5 text-indigo-400 hover:text-indigo-300 transition-all active:scale-95 cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                            </button>
                        </div>
                        
                        <!-- Multimodal OCR Receipt scanner -->
                        <div class="flex items-center gap-2">
                            <label class="flex-1 flex items-center justify-center gap-2 py-2.5 bg-slate-950 border border-slate-800 hover:border-indigo-500/50 rounded-xl text-xs font-semibold text-slate-300 active:scale-[0.98] transition-all cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                ສະແກນບິນ/ໃບບິນດ້ວຍ AI
                                <input type="file" id="receiptScanner" accept="image/*" onchange="processReceiptScanner(event)" class="hidden">
                            </label>
                        </div>
                    </div>
                    
                    <!-- Dynamic Autofill Preview Card (populated on successful AI call) -->
                    <div id="aiAutofillPreview" class="bg-slate-950 border border-emerald-500/30 rounded-2xl p-3 text-[11px] space-y-2 hidden">
                        <div class="flex justify-between items-center text-emerald-400 font-bold border-b border-slate-800 pb-1.5">
                            <span>✨ AI ວິເຄາະສຳເລັດແລ້ວ!</span>
                            <button onclick="rejectAiAutofill()" class="text-rose-400 hover:text-rose-300 cursor-pointer">ຍົກເລີກ</button>
                        </div>
                        <div class="grid grid-cols-2 gap-x-2 gap-y-1 text-slate-300">
                            <div>ປະເພດ: <span id="previewType" class="font-bold text-white"></span></div>
                            <div>ມູນຄ່າ: <span id="previewAmount" class="font-bold text-emerald-400"></span></div>
                            <div>ໝວດໝູ່: <span id="previewCategory" class="font-bold text-white"></span></div>
                            <div>ໝາຍເຫດ: <span id="previewNote" class="text-white italic"></span></div>
                            <div class="col-span-2">ວັນທີ: <span id="previewDate" class="font-bold text-white"></span></div>
                        </div>
                        <button onclick="confirmAiAutofill()" class="w-full py-2 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-extrabold rounded-xl transition-all active:scale-[0.98]">
                            ຢືນຢັນ ແລະ ບັນທຶກລົງຖານຂໍ້ມູນ
                        </button>
                    </div>
                </div>

                <!-- Quick Action Adding Panel -->
                <div class="bg-slate-800/40 border border-slate-800/80 rounded-3xl p-4.5 shadow-md space-y-4">
                    <!-- Type Selector tab -->
                    <div class="flex bg-slate-900 p-1 rounded-2xl border border-slate-950">
                        <button onclick="setFormType('expense')" id="formTypeExpense" class="flex-1 py-2 text-xs font-bold rounded-xl transition-all bg-rose-500 text-white shadow">ລາຍຈ່າຍ</button>
                        <button onclick="setFormType('income')" id="formTypeIncome" class="flex-1 py-2 text-xs font-bold rounded-xl transition-all text-slate-400">ລາຍຮັບ</button>
                    </div>

                    <!-- Number Screen Output -->
                    <div class="relative">
                        <input type="text" id="txAmountDisplay" readonly class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3.5 text-right font-mono text-3xl font-black text-white focus:outline-none focus:border-emerald-500 transition-all" value="0 LAK">
                    </div>

